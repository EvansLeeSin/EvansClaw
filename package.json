{
  "name": "evansclaw",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal personal chat agent built on pi-agent-core",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node --import tsx src/main.ts",
    "dev:web": "tsx src/web-main.ts",
    "telegram": "node --import tsx src/telegram-main.ts",
    "preweb": "npm run build:ui",
    "web": "node --import tsx src/web-main.ts",
    "dev:ui": "npm --prefix web run dev",
    "build:ui": "npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "typebox": "1.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
