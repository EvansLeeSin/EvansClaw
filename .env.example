# 复制为 .env 后填写。不要把 .env 提交到仓库。

# ---- 模型 ----
# 默认模型（DeepSeek，Anthropic 协议），必填
DEEPSEEK_API_KEY=
# 可选：deepseek-v4-flash（默认）或 deepseek-v4-pro
# EVANSCLAW_MODEL=deepseek-v4-flash
# 可选：data/models.yaml 中配置了 OpenAI Responses Provider 时填写对应变量
# OPENAI_API_KEY=

# ---- Web 访问 ----
# 监听非本机地址时必填：保护个人助手 API（浏览器里输入该 Token）
EVANSCLAW_WEB_TOKEN=
# 聊天室邀请码：远程模式下必填，否则聊天室不启用
EVANSCLAW_ROOM_INVITE_CODE=
# 宿主机映射端口（docker compose 使用）
# EVANSCLAW_PUBLISH_PORT=8787
# 关闭聊天室
# EVANSCLAW_ROOM_ENABLED=false
